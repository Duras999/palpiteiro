rules_version = '2';
// Regras do Firestore do Palpiteiro.
// O administrador principal está fixo aqui embaixo. Os outros administradores
// são cadastrados no painel e ficam no documento config/admins.
service cloud.firestore {
  match /databases/{database}/documents {

    function emailOk() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function dono() {
      return emailOk() && request.auth.token.email in ['jorgeluizsilvasiqueira@gmail.com'];
    }
    function outrosAdmins() {
      return exists(/databases/$(database)/documents/config/admins)
        ? get(/databases/$(database)/documents/config/admins).data.get('emails', [])
        : [];
    }
    function isAdmin() {
      return dono() || (emailOk() && request.auth.token.email in outrosAdmins());
    }
    function isMe(uid) { return request.auth != null && request.auth.uid == uid; }
    function isApproved() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }
    // Campos que o próprio usuário pode mexer (uso do app, WhatsApp, favoritos,
    // bilhete e sequência de dias). O status só o admin muda.
    function onlyUsageFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['opens', 'games', 'bets', 'tickets', 'lastSeen', 'whatsapp',
                  'favs', 'slip', 'streak', 'lastDay', 'leituras', 'push', 'avisos']);
    }

    // Lista de administradores. Só o dono mexe, para ninguém se promover
    // nem tirar o dono de dentro.
    match /config/admins {
      allow read: if emailOk();
      allow write: if dono();
    }
    // Resumo de acertos: qualquer um lê, sem cadastro, porque é a página
    // pública que mostra o retrospecto. Só o admin escreve.
    match /config/publico {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /config/{outro} {
      allow read: if isAdmin() || isApproved();
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isMe(uid) || isAdmin();
      // Novo cadastro sempre entra como "pendente", só com os campos do cadastro.
      allow create: if isMe(uid) && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['name', 'whatsapp', 'email', 'photo', 'provider', 'status',
             'adult', 'createdAt', 'lastSeen', 'opens', 'games', 'bets', 'tickets']);
      allow update: if isAdmin() || (isMe(uid) && onlyUsageFields());
      allow delete: if isAdmin();

      match /days/{day} {
        allow read: if isMe(uid) || isAdmin();
        allow write: if isMe(uid) && get(/databases/$(database)/documents/users/$(uid)).data.status == 'approved';
        allow delete: if isAdmin();
      }
    }

    // Bilhetes prontos do dia: o admin cadastra no painel, quem está aprovado só lê.
    // Quem está aprovado também pode somar 1 no contador de cliques em "Apostar".
    match /tickets/{id} {
      function soCliques() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks'])
          && request.resource.data.clicks is int
          && request.resource.data.clicks == resource.data.get('clicks', 0) + 1;
      }
      allow read: if isAdmin() || isApproved();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isApproved() && soCliques());
    }

    // Casas de apostas que aparecem nos botões do app.
    match /casas/{id} {
      allow read: if isAdmin() || isApproved();
      allow write: if isAdmin();
    }

    // Desfalques por time: o admin preenche no painel, quem está aprovado só lê.
    match /desfalques/{id} {
      allow read: if isAdmin() || isApproved();
      allow write: if isAdmin();
    }

    // Medição de acertos: os palpites de um jogo são gravados ANTES do apito
    // inicial e nunca mais mudam. O resultado só entra DEPOIS, uma única vez.
    // É isso que impede alguém de "acertar" olhando o placar.
    match /calibra/{id} {
      allow read: if isAdmin() || isApproved();
      allow create: if isApproved()
        && request.resource.data.avaliado == false
        && request.resource.data.placar == null
        && request.time < request.resource.data.kick;
      allow update: if isApproved()
        && resource.data.avaliado == false
        && request.time > resource.data.kick
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['placar', 'acertos', 'avaliado', 'updatedAt'])
        && request.resource.data.avaliado == true;
      allow delete: if isAdmin();
    }

    // Bolão: cada palpite de placar é um documento do próprio usuário.
    // O palpite só pode ser criado ou mudado ANTES do jogo começar (campo kick),
    // e os pontos só podem ser gravados DEPOIS, no máximo 5.
    match /bolao/{id} {
      function meu() { return request.auth != null && resource.data.uid == request.auth.uid; }
      function placarOk(d) {
        return d.h is int && d.h >= 0 && d.h <= 20 && d.a is int && d.a >= 0 && d.a <= 20;
      }
      allow read: if isAdmin() || isApproved();
      allow create: if isApproved()
        && request.resource.data.uid == request.auth.uid
        && id == request.auth.uid + '__' + request.resource.data.matchId
        && request.resource.data.pts == 0
        && request.resource.data.pontuado == false
        && request.resource.data.createdAt == request.time
        && request.time < request.resource.data.kick
        && placarOk(request.resource.data);
      allow update: if meu() && (
           (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['h', 'a', 'updatedAt'])
             && request.time < resource.data.kick && placarOk(request.resource.data))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pts', 'pontuado', 'updatedAt'])
             && request.time > resource.data.kick
             && request.resource.data.pts is int
             && request.resource.data.pts >= 0 && request.resource.data.pts <= 5)
      );
      allow delete: if isAdmin();
    }
  }
}
